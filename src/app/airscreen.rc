#include "resource.h"
#include <winresrc.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "airscreen.manifest"
IDI_APP ICON "app.ico"
IDR_LOGO RCDATA "logo_hi.png"

IDD_RENAME DIALOGEX 0, 0, 260, 88
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Receiver name"
FONT 10, "Segoe UI"
BEGIN
    LTEXT           "This is the name your iPhone shows in Screen Mirroring.", -1, 12, 10, 236, 18
    EDITTEXT        IDC_NAME, 12, 32, 236, 16, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Save", IDOK, 140, 62, 52, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 62, 52, 16
END

IDD_SCENES DIALOGEX 0, 0, 300, 266
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Scene text"
FONT 10, "Segoe UI"
BEGIN
    LTEXT           "Title and a smaller line for each scene. Leave a line empty to hide it.", -1, 12, 10, 276, 12
    LTEXT           "1  Intro", -1, 12, 30, 276, 10
    EDITTEXT        IDC_SCENE_TEXT0, 12, 42, 276, 14, ES_AUTOHSCROLL
    EDITTEXT        1011, 12, 59, 276, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "2  Screen: show a caption in the bottom-left corner", IDC_SCREEN_CAPTION, 12, 82, 276, 12
    EDITTEXT        IDC_SCREEN_TEXT0, 12, 96, 276, 14, ES_AUTOHSCROLL
    EDITTEXT        1017, 12, 113, 276, 14, ES_AUTOHSCROLL
    LTEXT           "3  Break", -1, 12, 136, 276, 10
    EDITTEXT        1012, 12, 148, 276, 14, ES_AUTOHSCROLL
    EDITTEXT        1013, 12, 165, 276, 14, ES_AUTOHSCROLL
    LTEXT           "4  Outro", -1, 12, 188, 276, 10
    EDITTEXT        1014, 12, 200, 276, 14, ES_AUTOHSCROLL
    EDITTEXT        1015, 12, 217, 276, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Save", IDOK, 180, 242, 52, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 236, 242, 52, 16
END
